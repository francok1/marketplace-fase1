{
  "name": "marketplace",
  "version": "1.0.0",
  "description": "Marketplace de servicios",
  "private": true,
  "scripts": {
    "tailwind:build": "tailwindcss -i ./app/styles.css -o ./app/tailwind-compiled.css",
    "tailwind:watch": "tailwindcss -i ./app/styles.css -o ./app/tailwind-compiled.css --watch",
    "dev": "npm run tailwind:build && next dev",
    "build": "npm run tailwind:build && next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.7.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.0.0",
    "date-fns": "^2.30.0",
    "lucide-react": "^0.292.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.3.2",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.3.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "prisma": "^5.7.0",
    "typescript": "^5.3.3"
  }
}
